{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"allowJs": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES2022"],
		"skipLibCheck": true,
		"isolatedModules": true
	},
	"include": [
		"main.ts",
		"font-registry.ts",
		"native-mathjax.ts",
		"settings.ts",
		"fonts/**/*.ts",
		"woff2.d.ts"
	]
}
